# Project root (auto-detected if not set — only needed if running from outside the project)
# PROJECT_ROOT=/path/to/openclaw-research

# Required: OpenAI API key for LLM provider and RAG embeddings
OPENAI_API_KEY=sk-your-key-here

# Required: Telegram chat ID for pipeline alerts and delivery
TELEGRAM_CHAT_ID=your-chat-id

# Optional: Path to OpenClaw config (default: ~/.openclaw/openclaw.json)
# OPENCLAW_CONFIG=~/.openclaw/openclaw.json

# Optional: Path to email credentials directory (default: ~/.config/openclaw-research)
# EMAIL_CREDENTIALS_DIR=~/.config/openclaw-research
